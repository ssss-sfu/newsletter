{% if header %}
<p style="font-family: 'Dm Sans', 'Trebuchet MS', Consolas, Arial, sans-serif, monospace;
padding: 24px 24px 0;
font-size: 24px;
font-weight: 700;
color: #24A98B;
line-height: 1.2;" class="blurbTitle">{{ header }}</p>
{% endif %}
{% for section in sections %}
    {% with
        subheader=section.subheader,
        blocks=section.blocks(),
        images=section.images
        %}
        {% if loop.index > 1 %}
            <div style="margin-top: 1em;">{% include "section.jinja" %}</div>
        {% else %}
            {% include "section.jinja" %}
        {% endif %}
    {% endwith %}
{% endfor %}
